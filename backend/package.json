{
  "name": "auros-backend",
  "version": "2.2.0",
  "description": "Auros — Backend System Automated procurement reconciliation and data cleaning platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node queues/worker.js",
    "worker:dev": "nodemon queues/worker.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint . --ext .js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "set-role": "node scripts/set-role.js",
    "py:install": "pip install -r python/requirements.txt --break-system-packages",
    "py:check": "node -e \"require('child_process').spawnSync(process.env.PYTHON_BIN||'python3',['python/data_engine.py'],{stdio:['ignore','inherit','inherit']})\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.2",
    "multer": "^2.1.1",
    "openai": "^6.35.0",
    "otplib": "^13.4.1",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "tar": "^7.5.22",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}